#!/usr/bin/env bash
# Everything CI will check, run here, in the order most likely to fail first.
#
#   scripts/preflight            before you push
#   scripts/preflight --quick    the inner loop: format, lint, and the fast tests
#   scripts/preflight --fix      format and regenerate, then check
#
# The point is that "I ran the tests" stops being a claim with a shape you have to
# remember. CLAUDE.md used to say "run cargo test and clippy", and the two things that
# actually broke this repository's builds were neither: a clippy lint from a newer
# toolchain than the one on the developer's machine, and a schema left unregenerated.
#
# Green here should mean green in CI. Where that cannot be true — cargo-deny and makeinfo
# are not always installed — the check says it was skipped rather than passing quietly.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

quick=0
fix=0
for arg in "$@"; do
  case "$arg" in
    --quick) quick=1 ;;
    --fix) fix=1 ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

pass=0 failed=0 skipped=0
failures=()

green() { printf '\033[32m%s\033[0m' "$1"; }
red() { printf '\033[31m%s\033[0m' "$1"; }
dim() { printf '\033[2m%s\033[0m' "$1"; }
[ -t 1 ] || { green() { printf '%s' "$1"; }; red() { printf '%s' "$1"; }; dim() { printf '%s' "$1"; }; }

# Run a check, keep its output only if it failed. An agent reading a wall of green has
# learned nothing; an agent reading the one failure has learned everything.
run() {
  local name=$1; shift
  local out
  printf '  %-28s ' "$name"
  if out=$("$@" 2>&1); then
    green "ok"; echo
    pass=$((pass + 1))
  else
    red "FAILED"; echo
    failed=$((failed + 1))
    failures+=("$name")
    echo "$out" | sed 's/^/    /' | tail -40
  fi
}

skip() {
  printf '  %-28s ' "$1"
  dim "skipped — $2"; echo
  skipped=$((skipped + 1))
}

# ─── The toolchain CI will use ───────────────────────────────────────────────
# CI installs `stable` on every run, so it is whatever stable is today. A machine that
# has not run `rustup update` in a while lints with an older clippy and passes locally
# what CI then rejects. That happened, cost a red build, and is entirely preventable —
# so it is checked first and it is checked by name, not by pinning a version that would
# itself go stale.
echo "toolchain"
if command -v rustup >/dev/null; then
  status=$(rustup check 2>/dev/null | grep '^stable' || true)
  if echo "$status" | grep -q 'update available'; then
    printf '  %-28s ' "stable is current"
    red "BEHIND"; echo
    echo "    $status"
    echo "    CI installs stable on every run, so it will lint with the newer one."
    echo "    Fix: rustup update stable"
    failed=$((failed + 1))
    failures+=("stable is current")
  else
    printf '  %-28s ' "stable is current"
    green "ok"; echo "  $(dim "$(rustc --version)")"
    pass=$((pass + 1))
  fi
else
  skip "stable is current" "no rustup"
fi

# ─── What CI runs, fastest and most-likely-to-fail first ─────────────────────
echo "code"
if [ "$fix" = 1 ]; then
  cargo fmt --all
  run "cargo fmt" cargo fmt --all -- --check
else
  run "cargo fmt" cargo fmt --all -- --check
fi
run "cargo clippy" cargo clippy --workspace --all-targets -- -D warnings

# nextest when it is installed, `cargo test` when it is not, and the same tests either
# way. What nextest buys here is a deadline on every test — a hang becomes a named
# failure instead of a run that never ends — and, with --quick, the inner loop without
# the four suites that dominate the wall clock. .config/nextest.toml has the reasoning.
#
# `--quick` here means fewer tests; the full run is what CI does and what a push needs.
if command -v cargo-nextest >/dev/null; then
  if [ "$quick" = 1 ]; then
    run "cargo nextest (quick)" cargo nextest run --profile quick \
      --workspace --features fontina-platform/platform-tests
  else
    run "cargo nextest" cargo nextest run \
      --workspace --features fontina-platform/platform-tests
  fi
else
  run "cargo test" cargo test --workspace --features fontina-platform/platform-tests
fi

# nextest does not run doctests. There are none today, which is the reason to check
# rather than the reason not to: without this the first one anybody writes would never
# run, and nothing would say so. `cargo test` above already covers them when nextest is
# not installed, so this is only for the path that used nextest.
if command -v cargo-nextest >/dev/null && [ "$quick" != 1 ]; then
  run "doctests" cargo test --workspace --doc
fi

[ "$quick" = 1 ] && { echo; echo "quick: $pass passed, $failed failed"; exit $((failed > 0)); }

# ─── Generated files, which are regenerated and never hand-edited ────────────
echo "generated"
schemas_current() {
  local tmp; tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN
  for s in face collection cli-output; do
    cargo run -q -p fontina-cli -- schema "$s" > "$tmp/$s.json" || return 1
    if [ "$fix" = 1 ]; then
      cp "$tmp/$s.json" "schemas/$s.json"
    else
      diff -u "schemas/$s.json" "$tmp/$s.json" || return 1
    fi
  done
}
run "schemas are current" schemas_current

if command -v cairn >/dev/null; then
  run "cairn check" cairn check
  if [ "$fix" = 1 ]; then cairn render -q >/dev/null 2>&1 || true; fi
  run "ROADMAP.md is current" cairn render --check
else
  skip "cairn check" "cairn is not installed"
fi

# ─── The guards that exist because something got through ─────────────────────
echo "guards"
# site/node_modules, a stray crates.real, and two 6.5 MB binaries each reached main
# before this existed. Same rule as CI, run against the same merge base.
no_large_files() {
  local base limit=$((1024 * 1024)) size path bad=0
  base=$(git merge-base origin/main HEAD 2>/dev/null) || return 0
  while read -r path; do
    [ -n "$path" ] || continue
    case "$path" in fixtures/*|fuzz/regressions/*) continue ;; esac
    size=$(git cat-file -s "$(git rev-parse "HEAD:$path" 2>/dev/null)" 2>/dev/null || echo 0)
    if [ "$size" -gt "$limit" ]; then
      echo "$path is $((size / 1024)) KB"
      bad=1
    fi
  done < <(git diff --name-only --diff-filter=AM "$base" HEAD)
  return $bad
}
run "no large files added" no_large_files

# A workflow file that does not parse produces no run at all, so the check that would
# have told you never appears — the pull request just goes quiet. Four workflows sat
# broken on main that way. actionlint knows the expression language, which neither a YAML
# parser nor `bash -n` does.
if command -v actionlint >/dev/null; then
  run "workflows are valid" actionlint
else
  skip "workflows are valid" "brew install actionlint"
fi

if command -v cargo-deny >/dev/null; then
  run "cargo deny" cargo deny check
else
  skip "cargo deny" "cargo install cargo-deny"
fi

if command -v makeinfo >/dev/null; then
  run "the manual builds" makeinfo --no-split -o /dev/null docs/fontina.texi
else
  skip "the manual builds" "install texinfo"
fi

# ─── Summary ─────────────────────────────────────────────────────────────────
echo
if [ "$failed" -eq 0 ]; then
  green "$pass passed"; [ "$skipped" -gt 0 ] && dim ", $skipped skipped"
  echo
  echo "CI checks the skipped ones. Push."
else
  red "$failed failed"; echo ": ${failures[*]}"
  echo "$pass passed, $skipped skipped."
fi
exit $((failed > 0))
