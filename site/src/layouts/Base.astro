---
// The one layout, in the shape of gcc.gnu.org: a main column, a nav column of boxed
// link groups on the right, and a copyright box across the bottom. See DESIGN.md.
import '../styles/site.css';
import { execSync } from 'node:child_process';
import { current } from '../releases';

interface Props {
  title: string;
  description?: string;
  /** An extra nav item at the top of the nav column: a heading and links. */
  extraNav?: { head: string; links: [string, string][] };
  /** Path of the page's source in the repository, for the "last modified" line. */
  source?: string;
  /** Keep the page out of search results. For the 404, which is not a page. */
  noindex?: boolean;
}

const { title, description, source, extraNav, noindex } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}${p}`;
const repo = 'https://github.com/oddurs/fontina';
const isHome = (Astro.url.pathname.replace(base, '') || '/') === '/';
const fullTitle = isHome ? 'fontina, a font manager' : `${title} - fontina`;

// Last modified: the commit date of the page source, else today.
let modified = new Date().toISOString().slice(0, 10);
if (source) {
  try {
    const d = execSync(`git log -1 --format=%cs -- "${source}"`, { cwd: '..', stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
    if (/^\d{4}-\d{2}-\d{2}$/.test(d)) modified = d;
  } catch {}
}

const groups: [string, [string, string, boolean?][]][] = [
  ['About fontina', [
    ['Mission', u('/mission/')],
    ['Releases', u('/releases/')],
    ['News', u('/news/')],
    ['Decisions', u('/adr/')],
    ['Contributors', `${repo}/graphs/contributors`],
  ]],
  ['Documentation', [
    ['Manual', u('/docs/')],
    ['Command reference', u('/docs/cli/'), true],
    ['FAQ', u('/faq/')],
  ]],
  ['Download', [
    ['Binaries', u('/download/')],
    ['Verifying', u('/download/#verifying-a-download'), true],
    ['From source', u('/download/#building-from-source'), true],
  ]],
  ['Sources', [
    ['Git', repo],
    ['Changelog', `${repo}/blob/main/CHANGELOG.md`],
    ['License', u('/license/')],
  ]],
  ['Development', [
    ['Roadmap', u('/roadmap/')],
    ['Contributing', u('/contributing/')],
    ['Web style', u('/style/')],
  ]],
  ['Bugs', [
    ['How to report', u('/bugs/')],
    ['Bug tracker', `${repo}/issues`],
    ['Security', u('/security/')],
  ]],
];
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex" />}
<meta name="generator" content={Astro.generator} />
<link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title="fontina news" href={u('/feed.xml')} />
<link rel="sitemap" href={u('/sitemap-index.xml')} />
</head>
<body>
<a class="skip" href="#content">Skip to content</a>

<header class="masthead">
  <div class="inner">
    <p class="wordmark">
      {isHome ? (
        <span class="lockup"><span class="mark" aria-hidden="true">&#x1F9C0; </span>fontina</span>
      ) : (
        <a class="lockup" href={u('/')}><span class="mark" aria-hidden="true">&#x1F9C0; </span>fontina</a>
      )}
      {current && <span class="version">{current.version}</span>}
    </p>
    <nav aria-label="Main">
      {([
        ['Manual', u('/docs/')],
        ['Download', u('/download/')],
        ['News', u('/news/')],
        ['Free software', u('/license/')],
        ['Source', repo],
      ] as [string, string][]).map(([label, href]) => (
        <a
          href={href}
          rel={href.startsWith('http') ? 'external' : undefined}
          aria-current={href === Astro.url.pathname ? 'page' : undefined}
        >{label}</a>
      ))}
    </nav>
  </div>
</header>

<div class="frame">
  <main class="main" id="content">
    <slot />
  </main>
  {extraNav && (
  <nav class="navcol" aria-label="On this manual">
    {extraNav && (
      <div class="navitem">
        <div class="navhead">{extraNav.head}</div>
        <div class="navbody">
          {extraNav.links.map(([label, href]) => (
            <a href={href} aria-current={href === Astro.url.pathname ? 'page' : undefined}>{label}</a>
          ))}
        </div>
      </div>
    )}
  </nav>
  )}
</div>
<footer class="footer">
  <div class="inner">
    <nav class="sitemap" aria-label="Site">
      {groups.map(([head, links]) => (
        <div class="navitem">
          <div class="navhead">{head}</div>
          <div class="navbody">
            {links.map(([label, href, sub]) => (
              <a
                href={href}
                class={sub ? 'sub' : undefined}
                aria-current={href === Astro.url.pathname ? 'page' : undefined}
              >{label}</a>
            ))}
          </div>
        </div>
      ))}
    </nav>

    <div class="footer-note">
      <div class="colophon">
        <p>
          <strong>fontina is free software.</strong> The program is under the
          <a href={u('/license/')}>GNU General Public License, version 3 or later</a>;
          these pages are under the GNU Free Documentation License, version 1.3 or later.
        </p>
        <p>
          It makes no network connections, collects nothing, and never asks for
          elevation.
        </p>
      </div>
      <div class="notice">
        <p set:html={`Questions go to the <a href="${u('/docs/')}">manual</a> first and the <a href="${repo}/issues">bug tracker</a> after. Corrections are pull requests; every page links its source.`} />
        <p>
          Copyright &copy; 2026 Oddur Sigurdsson and the fontina contributors. Verbatim
          copying and distribution of this entire article is permitted in any medium,
          provided this notice is preserved.
        </p>
        <p class="meta">
          <a href={repo}>Repository</a>{source && <> &middot; <a href={`${repo}/blob/main/${source}`}>This page's source</a></>} &middot; <a href={u('/feed.xml')}>RSS</a> &middot; Last modified {modified}
        </p>
      </div>
    </div>
  </div>
</footer>
</body>
</html>
