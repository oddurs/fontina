// program. If not, see <https://www.gnu.org/licenses/>.

// The one layout, in the shape of gcc.gnu.org: a main column, a nav column of boxed
// link groups on the right, and a copyright box across the bottom. See DESIGN.md.
import '../styles/site.css';
import { execSync } from 'node:child_process';
import { current } from '../releases';
import { masthead, sitemap, currentHref } from '../nav';

interface Props {
  title: string;
  description?: string;
  /** The section rail beside the content: a heading and the section's pages. */
  extraNav?: { head: string; links: [string, string][] };
  /** Path of the page's source in the repository, for the "last modified" line. */
  source?: string;
  /** Keep the page out of search results. For the 404, which is not a page. */
  noindex?: boolean;
}

const { title, description, source, extraNav, noindex } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}${p}`;
const repo = 'https://github.com/oddurs/fontina';
const isHome = (Astro.url.pathname.replace(base, '') || '/') === '/';
const fullTitle = isHome ? 'fontina, a font manager' : `${title} - fontina`;

// Last modified: the commit date of the page source, else today.
let modified = new Date().toISOString().slice(0, 10);
if (source) {
  try {
    const d = execSync(`git log -1 --format=%cs -- "${source}"`, { cwd: '..', stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
    if (/^\d{4}-\d{2}-\d{2}$/.test(d)) modified = d;
  } catch {}
}

const links = masthead(u);
const groups = sitemap(u);

// Where you are, worked out once per list.
//
// Section-aware, which the old test was not: it compared the href to the path for
// equality, so nothing was marked on any page below a section index — the whole manual,
// every decision record, every news post.
//
// Per list rather than per link, because `aria-current` is singular and several links in
// one list can cover one page: the footer holds both `/docs/` and `/docs/cli/`, and on
// the command reference both match. `currentHref` picks the deepest.
const deepest = (hrefs: string[]) => currentHref(hrefs, Astro.url.pathname, u('/'));
const mastheadHere = deepest(links.map((l) => l.href));
const sitemapHere = deepest(groups.flatMap((g) => g.links.map((l) => l.href)));
const railHere = extraNav ? deepest(extraNav.links.map(([, href]) => href)) : undefined;

const page = (href: string, current: string | undefined) =>
  href === current ? 'page' : undefined;
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex" />}
<meta name="generator" content={Astro.generator} />
<link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title="fontina news" href={u('/feed.xml')} />
<link rel="sitemap" href={u('/sitemap-index.xml')} />
</head>
<body>
<a class="skip" href="#content">Skip to content</a>

<header class="masthead">
  <div class="inner">
    <p class="wordmark">
      {isHome ? (
        <span class="lockup"><svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M2.6 25.1V13.4c0-.73.45-1.38 1.13-1.63L26.6 3.4c1.12-.4 2.3.43 2.3 1.63v20.07c0 .96-.78 1.74-1.74 1.74H4.34a1.74 1.74 0 0 1-1.74-1.74z" fill="#f0c24b" stroke="#c9932a" stroke-width="1.3" stroke-linejoin="round"/><circle cx="9.4" cy="20.6" r="2.3" fill="#fffdf5"/><circle cx="19.2" cy="16.4" r="1.85" fill="#fffdf5"/><circle cx="24.6" cy="21.8" r="1.35" fill="#fffdf5"/></svg>fontina</span>
      ) : (
        <a class="lockup" href={u('/')}><svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M2.6 25.1V13.4c0-.73.45-1.38 1.13-1.63L26.6 3.4c1.12-.4 2.3.43 2.3 1.63v20.07c0 .96-.78 1.74-1.74 1.74H4.34a1.74 1.74 0 0 1-1.74-1.74z" fill="#f0c24b" stroke="#c9932a" stroke-width="1.3" stroke-linejoin="round"/><circle cx="9.4" cy="20.6" r="2.3" fill="#fffdf5"/><circle cx="19.2" cy="16.4" r="1.85" fill="#fffdf5"/><circle cx="24.6" cy="21.8" r="1.35" fill="#fffdf5"/></svg>fontina</a>
      )}
      {current && <span class="version">{current.version}</span>}
    </p>
    <nav aria-label="Main">
      {links.map(({ label, href }) => (
        <a
          href={href}
          rel={href.startsWith('http') ? 'external' : undefined}
          aria-current={page(href, mastheadHere)}
        >{label}</a>
      ))}
    </nav>
  </div>
</header>

<div class="frame">
  <main class="main" id="content">
    <slot />
  </main>
  {extraNav && (
    <nav class="navcol" aria-label={extraNav.head}>
      <div class="navitem">
        <div class="navhead">{extraNav.head}</div>
        <div class="navbody">
          {extraNav.links.map(([label, href]) => (
            <a href={href} aria-current={page(href, railHere)}>{label}</a>
          ))}
        </div>
      </div>
    </nav>
  )}
</div>
<footer class="footer">
  <div class="inner">
    <nav class="sitemap" aria-label="Site">
      {groups.map(({ head, links }) => (
        <div class="navitem">
          <div class="navhead">{head}</div>
          <div class="navbody">
            {links.map(({ label, href, sub }) => (
              <a
                href={href}
                class={sub ? 'sub' : undefined}
                aria-current={page(href, sitemapHere)}
              >{label}</a>
            ))}
          </div>
        </div>
      ))}
    </nav>

    <div class="footer-note">
      <div class="colophon">
        <p>
          <strong>fontina is free software.</strong> The program is under the
          <a href={u('/license/')}>GNU General Public License, version 3 or later</a>;
          these pages are under the GNU Free Documentation License, version 1.3 or later.
        </p>
        <p>
          It makes no network connections, collects nothing, and never asks for
          elevation.
        </p>
      </div>
      <div class="notice">
        <p set:html={`Questions go to the <a href="${u('/docs/')}">manual</a> first and the <a href="${repo}/issues">bug tracker</a> after. Corrections are pull requests; every page links its source.`} />
        <p>
          Copyright &copy; 2026 Oddur Sigurdsson and the fontina contributors. Verbatim
          copying and distribution of this entire article is permitted in any medium,
          provided this notice is preserved.
        </p>
        <p class="meta">
          <a href={repo}>Repository</a>{source && <> &middot; <a href={`${repo}/blob/main/${source}`}>This page's source</a></>} &middot; <a href={u('/feed.xml')}>RSS</a> &middot; Last modified {modified}
        </p>
      </div>
    </div>
  </div>
</footer>
</body>
</html>
