---
// The one layout. Everything on the site is this: a masthead, a horizontal rule,
// the content, a horizontal rule, a footer.
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  /** Path of the source file in the repository, for the "page source" footer link. */
  source?: string;
}

const { title, description, source } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}${p}`;
const repo = 'https://github.com/oddurs/unifont';
const today = new Date().toISOString().slice(0, 10);
const nav: [string, string][] = [
  ['Home', '/'],
  ['Download', '/download/'],
  ['Manual', '/docs/'],
  ['FAQ', '/faq/'],
  ['News', '/news/'],
  ['Decisions', '/adr/'],
  ['Roadmap', '/roadmap/'],
  ['Contributing', '/contributing/'],
  ['Bugs', '/bugs/'],
  ['Security', '/security/'],
  ['License', '/license/'],
];
const current = Astro.url.pathname.replace(base, '') || '/';
const fullTitle = current === '/' ? 'unifont' : `${title} - unifont`;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<meta name="generator" content={Astro.generator} />
<link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title="unifont news" href={u('/feed.xml')} />
<link rel="sitemap" href={u('/sitemap-index.xml')} />

<header>
  <p class="masthead"><a href={u('/')}>unifont</a></p>
  <p class="tagline">A lightweight, cross-platform, free software font manager.</p>
  <nav aria-label="Site">
    [ {nav.map(([label, href], i) => (
      <>
        {i > 0 && ' | '}
        {href === current
          ? <strong>{label}</strong>
          : <a href={u(href)}>{label}</a>}
      </>
    ))} ]
  </nav>
</header>
<hr />
<main>
  <slot />
</main>
<hr />
<footer>
  <p>
    Copyright &copy; 2026 Oddur Sigurdsson and the unifont contributors.
    The software is free software, licensed <a href={u('/license/')}>MIT OR Apache-2.0</a>.
  </p>
  <p>
    Verbatim copying and distribution of this entire page are permitted in any medium,
    provided this notice is preserved.
  </p>
  <p class="nav">
    Built {today}
    &middot; <a href={repo}>Source repository</a>
    {source && <> &middot; <a href={`${repo}/blob/main/${source}`}>Page source</a></>}
    &middot; <a href={u('/feed.xml')}>RSS</a>
    &middot; <a href={u('/sitemap-index.xml')}>Sitemap</a>
    &middot; No JavaScript, no cookies, no tracking.
  </p>
</footer>
