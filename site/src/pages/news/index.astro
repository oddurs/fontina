---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}${p}`;
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const rendered = await Promise.all(news.map(async (n) => ({ n, Content: (await render(n)).Content })));
---
<Base title="News" description="Announcements and release notes for unifont." source="site/src/content/news">
  <h1>News</h1>
  <p class="meta">Also available as an <a href={u('/feed.xml')}>RSS feed</a>. Release notes for every version are on the
    <a href="https://github.com/oddurs/unifont/releases">releases page</a> and in
    <a href="https://github.com/oddurs/unifont/blob/main/CHANGELOG.md"><code>CHANGELOG.md</code></a>.</p>
  {rendered.map(({ n, Content }) => (
    <article>
      <h2 id={n.id}>{n.data.date.toISOString().slice(0, 10)}: <a href={u(`/news/${n.id}/`)}>{n.data.title}</a></h2>
      <Content />
    </article>
  ))}
</Base>
