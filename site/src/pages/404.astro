---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}${p}`;
---
<Base title="Not found" description="There is no page at this address." noindex={true}>
  <h1>404: not found</h1>
  <p>There is no page at this address. It may have moved, or the link may be wrong.</p>
  <p>The places most things are:</p>
  <ul>
    <li><a href={u('/')}>The front page</a>, which says what fontina is and shows it running.</li>
    <li><a href={u('/docs/')}>The manual</a>, and the <a href={u('/docs/cli/')}>command reference</a> inside it.</li>
    <li><a href={u('/download/')}>Download</a>, for a release archive or the source.</li>
    <li><a href={u('/faq/')}>The FAQ</a>, for what the manual does not answer.</li>
  </ul>
  <p class="small soft">
    If a link on this site brought you here, that is a bug in the site; please
    <a href="https://github.com/oddurs/fontina/issues">report it</a>.
  </p>
</Base>
