import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  // Numbered, so the file name is the order and the series reads as one.
  const adrs = (await getCollection('adr')).sort((a, b) => a.id.localeCompare(b.id));
  return adrs.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, all: adrs, prev: adrs[i - 1], next: adrs[i + 1] },
  }));
}

const { entry, all, prev, next } = Astro.props;
const { Content } = await render(entry);
const heading = (e: { body?: string; id: string }) =>
  e.body?.match(/^#\s+(.+)$/m)?.[1] ?? e.id;
const title = heading(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}${p}`;
---
<Base title={`ADR ${title}`} description={`Architecture decision record: ${title}`} source={`docs/adr/${entry.id}.md`}
  extraNav={{
    head: 'Decisions',
    links: [
      ['All records', u('/adr/')],
      ...all.map((e): [string, string] => [heading(e), u(`/adr/${e.id}/`)]),
    ],
  }}>
  <p class="node-nav">
    {next && <>Next: <a href={u(`/adr/${next.id}/`)}>{heading(next)}</a>, &nbsp;</>}
    {prev && <>Previous: <a href={u(`/adr/${prev.id}/`)}>{heading(prev)}</a>, &nbsp;</>}
    Up: <a href={u('/adr/')}>Architecture decision records</a>
  </p>
  <Content />
</Base>
