---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const adrs = await getCollection('adr');
  return adrs.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = entry.body?.match(/^#\s+(.+)$/m)?.[1] ?? entry.id;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`ADR ${title}`} description={`Architecture decision record: ${title}`} source={`docs/adr/${entry.id}.md`}>
  <p class="node-nav">Up: <a href={`${base}/adr/`}>Architecture decision records</a></p>
  <Content />
</Base>
