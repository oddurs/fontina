/target
# Build directories from side-by-side benchmark runs (`CARGO_TARGET_DIR=target-x`), and
# any binary left beside them. A 6.5 MB `fontina-old` reached main this way.
/target-*
/fontina-old
/fontina.exe
**/*.rs.bk
*.pending-snap
.DS_Store
/apps/desktop/node_modules
/apps/desktop/dist
/apps/desktop/src-tauri/target
*.db
*.db-wal
*.db-shm
# Agent worktrees (see CLAUDE.md, "Working alongside other agents"). Some tools put
# their own worktrees under .claude/; those are nobody's to commit either.
/.worktrees/
/.claude/worktrees/
# The docs site lives in its own PRs; its build outputs and dependencies never belong in git.
node_modules/
/site/dist/
/site/.astro/
