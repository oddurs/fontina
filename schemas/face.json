{
  "$defs": {
    "AxisInfo": {
      "description": "One variation axis from `fvar`.",
      "properties": {
        "default": {
          "description": "The value this face takes when no axis is set.",
          "format": "float",
          "type": "number"
        },
        "hidden": {
          "description": "`fvar` flag: the axis is not meant to be shown in a user interface.",
          "type": "boolean"
        },
        "max": {
          "description": "Maximum in user coordinates.",
          "format": "float",
          "type": "number"
        },
        "min": {
          "description": "Minimum in user coordinates.",
          "format": "float",
          "type": "number"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "description": "Four-character axis tag, e.g. `wght`.",
          "type": "string"
        }
      },
      "required": [
        "tag",
        "min",
        "default",
        "max",
        "hidden"
      ],
      "type": "object"
    },
    "Capabilities": {
      "description": "What the face can do, read from which tables are present.",
      "properties": {
        "bitmap_strikes": {
          "description": "An `EBDT`/`EBLC` or `bloc`/`bdat` strike is present.",
          "type": "boolean"
        },
        "color": {
          "description": "Colour formats present, empty for a monochrome face.",
          "items": {
            "$ref": "#/$defs/ColorFormat"
          },
          "type": "array"
        },
        "hinting": {
          "description": "TrueType hinting programs present (`fpgm`/`prep`/`cvt `).",
          "type": "boolean"
        },
        "kern_table": {
          "description": "A legacy `kern` table is present, independent of GPOS kerning.",
          "type": "boolean"
        },
        "math": {
          "description": "A `MATH` table is present.",
          "type": "boolean"
        },
        "outlines": {
          "$ref": "#/$defs/OutlineFormat",
          "description": "Where the outlines are."
        }
      },
      "required": [
        "outlines",
        "color",
        "hinting",
        "bitmap_strikes",
        "math",
        "kern_table"
      ],
      "type": "object"
    },
    "ColorFormat": {
      "description": "A colour glyph format the face carries. A face may carry several.",
      "oneOf": [
        {
          "const": "colrv0",
          "description": "`COLR` version 0: layered solid colours.",
          "type": "string"
        },
        {
          "const": "colrv1",
          "description": "`COLR` version 1: gradients and compositing.",
          "type": "string"
        },
        {
          "const": "svg",
          "description": "An `SVG ` table.",
          "type": "string"
        },
        {
          "const": "sbix",
          "description": "An `sbix` table of colour bitmaps.",
          "type": "string"
        },
        {
          "const": "cbdt",
          "description": "`CBDT`/`CBLC` colour bitmaps.",
          "type": "string"
        }
      ]
    },
    "Container": {
      "description": "Font container format, detected from the file's magic bytes.",
      "oneOf": [
        {
          "const": "ttf",
          "description": "TrueType outlines in an sfnt wrapper (`00 01 00 00` or `true`).",
          "type": "string"
        },
        {
          "const": "otf",
          "description": "CFF/CFF2 outlines in an sfnt wrapper (`OTTO`).",
          "type": "string"
        },
        {
          "const": "ttc",
          "description": "TrueType/OpenType collection (`ttcf`).",
          "type": "string"
        },
        {
          "const": "woff",
          "description": "WOFF 1.0.",
          "type": "string"
        },
        {
          "const": "woff2",
          "description": "WOFF 2.0.",
          "type": "string"
        }
      ]
    },
    "Coverage": {
      "description": "What the face can actually set, derived from `cmap` rather than claimed.",
      "properties": {
        "codepoints": {
          "description": "Total codepoints in `cmap`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "ranges": {
          "description": "Inclusive codepoint ranges, merged, suitable for `unicode-range`.",
          "items": {
            "items": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "scripts": {
          "description": "Scripts sorted by codepoint count, descending.",
          "items": {
            "$ref": "#/$defs/ScriptCoverage"
          },
          "type": "array"
        }
      },
      "required": [
        "codepoints",
        "scripts",
        "ranges"
      ],
      "type": "object"
    },
    "CssDescriptor": {
      "description": "The face expressed as CSS Fonts Level 4 descriptors.",
      "properties": {
        "family": {
          "type": "string"
        },
        "format": {
          "description": "The `format()` hint for `@font-face src`, e.g. `woff2`.",
          "type": "string"
        },
        "stretch": {
          "description": "`font-stretch` value or range, e.g. `100%` or `75% 125%`.",
          "type": "string"
        },
        "style": {
          "description": "`font-style`, e.g. `normal`, `italic`, `oblique 12deg`, `oblique -10deg 0deg`.",
          "type": "string"
        },
        "weight": {
          "description": "`font-weight` value or range, e.g. `400` or `100 900`.",
          "type": "string"
        }
      },
      "required": [
        "family",
        "weight",
        "stretch",
        "style",
        "format"
      ],
      "type": "object"
    },
    "EmbeddingLevel": {
      "description": "The `OS/2.fsType` embedding level. Reported, never enforced; see `freedom`.",
      "oneOf": [
        {
          "const": "installable",
          "description": "No embedding restriction stated.",
          "type": "string"
        },
        {
          "const": "restricted_license",
          "description": "The font claims it may not be embedded without a separate licence.",
          "type": "string"
        },
        {
          "const": "preview_and_print",
          "description": "The font claims embedding is for viewing and printing only.",
          "type": "string"
        },
        {
          "const": "editable",
          "description": "The font claims embedded documents may be edited.",
          "type": "string"
        }
      ]
    },
    "EmbeddingRights": {
      "description": "Decoded `OS/2.fsType` embedding permissions.",
      "properties": {
        "bitmap_only": {
          "description": "`fsType` bit 9.",
          "type": "boolean"
        },
        "level": {
          "$ref": "#/$defs/EmbeddingLevel",
          "description": "The least restrictive level the bits allow."
        },
        "no_subsetting": {
          "description": "`fsType` bit 8.",
          "type": "boolean"
        }
      },
      "required": [
        "level",
        "no_subsetting",
        "bitmap_only"
      ],
      "type": "object"
    },
    "Features": {
      "description": "What the shaping tables declare, as opposed to what the font covers.",
      "properties": {
        "gpos": {
          "description": "Distinct GPOS feature tags, sorted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "gsub": {
          "description": "Distinct GSUB feature tags, sorted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scripts": {
          "items": {
            "$ref": "#/$defs/ScriptInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "gsub",
        "gpos",
        "scripts"
      ],
      "type": "object"
    },
    "FileInfo": {
      "description": "The file a face was read from.",
      "properties": {
        "blake3": {
          "description": "BLAKE3 hash of the file bytes, hex.",
          "type": "string"
        },
        "container": {
          "$ref": "#/$defs/Container",
          "description": "Container format, from the magic bytes rather than the extension."
        },
        "face_count": {
          "description": "Number of faces in the file (1 unless a collection).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mtime": {
          "description": "Modification time, seconds since the Unix epoch.",
          "format": "int64",
          "type": "integer"
        },
        "path": {
          "description": "Absolute path as scanned.",
          "type": "string"
        },
        "size": {
          "description": "File size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size",
        "mtime",
        "blake3",
        "container",
        "face_count"
      ],
      "type": "object"
    },
    "Freedom": {
      "description": "Whether a license grants the four freedoms.",
      "oneOf": [
        {
          "const": "free",
          "description": "The license grants all four freedoms.",
          "type": "string"
        },
        {
          "const": "nonfree",
          "description": "The license withholds at least one of them.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "A license is stated, but it is not one that is known to be free.",
          "type": "string"
        },
        {
          "const": "unstated",
          "description": "The font carries no license information at all. No permission is stated, so in\nlaw none is granted, however the font was meant to be shared.",
          "type": "string"
        }
      ]
    },
    "InstanceInfo": {
      "description": "A named instance from `fvar`.",
      "properties": {
        "coordinates": {
          "description": "User-space coordinates, in axis order.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "type": "array"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "postscript_name": {
          "description": "Name ID 6. Unique per face, and what `dupes` matches on first.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "coordinates"
      ],
      "type": "object"
    },
    "LicenseInfo": {
      "description": "What the font says about its own licence.",
      "properties": {
        "description": {
          "description": "Name ID 10.",
          "type": [
            "string",
            "null"
          ]
        },
        "freedom": {
          "$ref": "#/$defs/Freedom",
          "default": "unstated",
          "description": "Whether `spdx` grants the four freedoms. Derived by `crate::freedom`; carried in\nthe exported JSON so a consumer need not repeat the judgement."
        },
        "reserved_font_names": {
          "description": "OFL Reserved Font Names declared in the copyright or license text.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "spdx": {
          "description": "SPDX identifier or expression when recognisable, e.g. `OFL-1.1`. `LicenseRef-Unknown`\nwhen license text exists but is not recognised. Absent when the font carries none.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Metrics": {
      "description": "Vertical metrics and the dates, from `head`, `hhea` and `OS/2`.",
      "properties": {
        "ascender": {
          "description": "`hhea.ascender`.",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768,
          "type": "integer"
        },
        "cap_height": {
          "description": "`OS/2.sCapHeight`, present from version 2.",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768,
          "type": [
            "integer",
            "null"
          ]
        },
        "created": {
          "description": "`head.created` as RFC 3339, when set.",
          "type": [
            "string",
            "null"
          ]
        },
        "descender": {
          "description": "`hhea.descender`, negative below the baseline.",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768,
          "type": "integer"
        },
        "is_fixed_pitch": {
          "description": "`post.isFixedPitch`. What the font claims; advance widths are not re-measured.",
          "type": "boolean"
        },
        "italic_angle": {
          "description": "`post.italicAngle`, degrees counter-clockwise from vertical.",
          "format": "float",
          "type": "number"
        },
        "line_gap": {
          "description": "`hhea.lineGap`.",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768,
          "type": "integer"
        },
        "modified": {
          "description": "`head.modified` as RFC 3339, when set.",
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "description": "`head.fontRevision`.",
          "format": "double",
          "type": "number"
        },
        "units_per_em": {
          "description": "`head.unitsPerEm`. Every other value here is in these units.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "x_height": {
          "description": "`OS/2.sxHeight`, present from version 2.",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "units_per_em",
        "ascender",
        "descender",
        "line_gap",
        "italic_angle",
        "is_fixed_pitch",
        "revision"
      ],
      "type": "object"
    },
    "NameRecord": {
      "description": "One record from the `name` table.",
      "properties": {
        "encoding_id": {
          "description": "Encoding ID, interpreted against `platform_id`.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "language": {
          "description": "BCP 47 tag when the platform language id is recognised.",
          "type": [
            "string",
            "null"
          ]
        },
        "language_id": {
          "description": "Language ID, interpreted against `platform_id`; `language` is its BCP 47 form.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "name_id": {
          "description": "`name` table name ID: 1 family, 2 subfamily, 4 full name, 6 PostScript, 16/17 typographic.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "platform_id": {
          "description": "Platform ID: 0 Unicode, 1 Macintosh, 3 Windows.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "description": "The decoded string.",
          "type": "string"
        }
      },
      "required": [
        "name_id",
        "platform_id",
        "encoding_id",
        "language_id",
        "value"
      ],
      "type": "object"
    },
    "Names": {
      "description": "Resolved names. `family`/`subfamily` prefer the typographic names (IDs 16/17) over\nthe legacy ones (IDs 1/2), which is what groups a family correctly.",
      "properties": {
        "copyright": {
          "description": "Name ID 0. Scanned for a licence and for OFL reserved font names.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "designer": {
          "description": "Name ID 9.",
          "type": [
            "string",
            "null"
          ]
        },
        "designer_url": {
          "description": "Name ID 12.",
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": "string"
        },
        "full_name": {
          "description": "Name ID 4.",
          "type": [
            "string",
            "null"
          ]
        },
        "legacy_family": {
          "description": "Name ID 1, kept when ID 16 exists and differs from it.",
          "type": [
            "string",
            "null"
          ]
        },
        "legacy_subfamily": {
          "description": "Name ID 2, kept when ID 17 exists and differs from it.",
          "type": [
            "string",
            "null"
          ]
        },
        "manufacturer": {
          "description": "Name ID 8.",
          "type": [
            "string",
            "null"
          ]
        },
        "postscript_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "sample_text": {
          "description": "Name ID 19. Preferred over the built-in pangram when previewing.",
          "type": [
            "string",
            "null"
          ]
        },
        "subfamily": {
          "type": "string"
        },
        "trademark": {
          "description": "Name ID 7.",
          "type": [
            "string",
            "null"
          ]
        },
        "unique_id": {
          "description": "Name ID 3.",
          "type": [
            "string",
            "null"
          ]
        },
        "vendor_url": {
          "description": "Name ID 11.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Name ID 5, the version string as the font states it.",
          "type": [
            "string",
            "null"
          ]
        },
        "wws_family": {
          "description": "Name ID 21. Weight/width/slope family, where the font declares one.",
          "type": [
            "string",
            "null"
          ]
        },
        "wws_subfamily": {
          "description": "Name ID 22.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "family",
        "subfamily"
      ],
      "type": "object"
    },
    "Os2Info": {
      "description": "The `OS/2` table, kept whole because callers disagree about which fields matter.",
      "properties": {
        "codepage_ranges": {
          "description": "`OS/2.ulCodePageRange1..2`, present from version 1.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "embedding": {
          "$ref": "#/$defs/EmbeddingRights",
          "description": "`fs_type`, decoded."
        },
        "fs_selection": {
          "description": "`OS/2.fsSelection` bits.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "fs_type": {
          "description": "Raw `fsType` bits; `embedding` is the decoded form.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "typo_ascender": {
          "description": "`OS/2.sTypoAscender`.",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768,
          "type": [
            "integer",
            "null"
          ]
        },
        "typo_descender": {
          "description": "`OS/2.sTypoDescender`.",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768,
          "type": [
            "integer",
            "null"
          ]
        },
        "unicode_ranges": {
          "description": "`OS/2.ulUnicodeRange1..4`. What the font claims; `coverage` is what it has.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "use_typo_metrics": {
          "description": "`fsSelection` bit 7: prefer the typo metrics over the hhea ones.",
          "type": "boolean"
        },
        "vendor_id": {
          "description": "`OS/2.achVendID`, four characters.",
          "type": "string"
        },
        "version": {
          "description": "`OS/2.version`; later versions carry more fields.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "weight_class": {
          "description": "`OS/2.usWeightClass`, 1–1000.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "width_class": {
          "description": "`OS/2.usWidthClass`, 1–9.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "weight_class",
        "width_class",
        "fs_type",
        "embedding",
        "vendor_id",
        "fs_selection",
        "use_typo_metrics",
        "unicode_ranges"
      ],
      "type": "object"
    },
    "OutlineFormat": {
      "description": "Which outline table the glyphs live in.",
      "oneOf": [
        {
          "const": "glyf",
          "description": "TrueType outlines.",
          "type": "string"
        },
        {
          "const": "cff",
          "description": "CFF outlines.",
          "type": "string"
        },
        {
          "const": "cff2",
          "description": "CFF2 outlines, which are variable.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "No outline table: a bitmap-only font.",
          "type": "string"
        }
      ]
    },
    "ScriptCoverage": {
      "description": "How much of one Unicode script the face covers.",
      "properties": {
        "codepoints": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "script": {
          "description": "ISO 15924 code from Unicode script property, e.g. `Latn`, `Arab`, `Zyyy` (Common).",
          "type": "string"
        }
      },
      "required": [
        "script",
        "codepoints"
      ],
      "type": "object"
    },
    "ScriptInfo": {
      "description": "One OpenType script and the language systems declared under it.",
      "properties": {
        "languages": {
          "description": "OpenType language system tags declared under the script.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tag": {
          "description": "OpenType script tag, e.g. `latn`, `arab`, `DFLT`.",
          "type": "string"
        }
      },
      "required": [
        "tag",
        "languages"
      ],
      "type": "object"
    },
    "Slope": {
      "description": "How the face slopes, in the CSS Fonts Level 4 sense.",
      "oneOf": [
        {
          "description": "Upright.",
          "properties": {
            "kind": {
              "const": "normal",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "True italic letterforms: `OS/2.fsSelection` ITALIC or `head.macStyle`.",
          "properties": {
            "kind": {
              "const": "italic",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "angle": {
              "description": "Degrees, from the `slnt` axis or `post.italicAngle`, where the font gives one.",
              "format": "float",
              "type": [
                "number",
                "null"
              ]
            },
            "kind": {
              "const": "oblique",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Style": {
      "description": "Where the face sits on the three CSS style axes.",
      "properties": {
        "css": {
          "$ref": "#/$defs/CssDescriptor",
          "description": "The same face as CSS descriptors, carrying ranges where it is variable."
        },
        "slope": {
          "$ref": "#/$defs/Slope",
          "description": "Upright, italic or oblique."
        },
        "weight": {
          "description": "Weight on the CSS 1–1000 scale (from `OS/2.usWeightClass` or the `wght` default).",
          "format": "float",
          "type": "number"
        },
        "width": {
          "description": "Width as a percentage where 100 is normal (from `usWidthClass` or the `wdth` default).",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "weight",
        "width",
        "slope",
        "css"
      ],
      "type": "object"
    },
    "VariableInfo": {
      "description": "The variable-font tables, absent for a static face.",
      "properties": {
        "axes": {
          "description": "Axes in `fvar` order; `coordinates` on an instance follows the same order.",
          "items": {
            "$ref": "#/$defs/AxisInfo"
          },
          "type": "array"
        },
        "has_avar": {
          "description": "An `avar` table is present, so user and normalised coordinates differ.",
          "type": "boolean"
        },
        "has_stat": {
          "description": "A `STAT` table is present.",
          "type": "boolean"
        },
        "instances": {
          "description": "Named instances, in `fvar` order.",
          "items": {
            "$ref": "#/$defs/InstanceInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "axes",
        "instances",
        "has_avar",
        "has_stat"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Everything fontina knows about one face.",
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/Capabilities",
      "description": "Outline format, colour, hinting, bitmaps, MATH, kern."
    },
    "coverage": {
      "$ref": "#/$defs/Coverage",
      "description": "Codepoints, scripts and ranges, from `cmap`."
    },
    "features": {
      "$ref": "#/$defs/Features",
      "description": "GSUB and GPOS feature tags and the scripts that declare them."
    },
    "file": {
      "$ref": "#/$defs/FileInfo",
      "description": "The file this face was read from."
    },
    "glyph_count": {
      "description": "`maxp.numGlyphs`.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "identity_hash": {
      "description": "BLAKE3 over the `name` table and outline tables: identifies the same face across\ncontainers (TTF vs WOFF2 of one font hash the same).",
      "type": "string"
    },
    "index": {
      "description": "Index of the face within its file (0 unless a collection).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "license": {
      "$ref": "#/$defs/LicenseInfo",
      "description": "SPDX identifier where recognised, and whether it is free."
    },
    "metrics": {
      "$ref": "#/$defs/Metrics",
      "description": "Vertical metrics and dates."
    },
    "name_records": {
      "description": "The whole `name` table, so nothing is lost to resolution.",
      "items": {
        "$ref": "#/$defs/NameRecord"
      },
      "type": "array"
    },
    "names": {
      "$ref": "#/$defs/Names",
      "description": "Resolved names, typographic where the font provides them."
    },
    "os2": {
      "anyOf": [
        {
          "$ref": "#/$defs/Os2Info"
        },
        {
          "type": "null"
        }
      ],
      "description": "The `OS/2` table, absent only if the font has none."
    },
    "schema_version": {
      "description": "Bumped when this model changes in a way a reader cannot ignore.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "style": {
      "$ref": "#/$defs/Style",
      "description": "Weight, width and slope, on the CSS scales."
    },
    "variable": {
      "anyOf": [
        {
          "$ref": "#/$defs/VariableInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Axes and named instances, absent for a static face."
    }
  },
  "required": [
    "schema_version",
    "file",
    "index",
    "names",
    "name_records",
    "style",
    "metrics",
    "features",
    "coverage",
    "capabilities",
    "license",
    "glyph_count",
    "identity_hash"
  ],
  "title": "FaceMetadata",
  "type": "object"
}
