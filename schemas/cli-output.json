{
  "$defs": {
    "ActivationRecord": {
      "properties": {
        "activated_at": {
          "format": "int64",
          "type": "integer"
        },
        "face": {
          "$ref": "#/$defs/FaceSummary"
        },
        "installed_path": {
          "description": "Where `install` put the copy, for `uninstall`.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/ActivationState"
        }
      },
      "required": [
        "face",
        "state",
        "activated_at"
      ],
      "type": "object"
    },
    "ActivationState": {
      "description": "How a face was made available to the OS through fontina.",
      "oneOf": [
        {
          "const": "session",
          "description": "Registered until logout or reboot.",
          "type": "string"
        },
        {
          "const": "user",
          "description": "Registered persistently for the current user, in place.",
          "type": "string"
        },
        {
          "const": "installed",
          "description": "Copied (or linked) into the per-user font directory.",
          "type": "string"
        }
      ]
    },
    "BlockCoverage": {
      "description": "One Unicode block and the codepoints a face covers within it.",
      "properties": {
        "block": {
          "type": "string"
        },
        "block_size": {
          "description": "Size of the block, for a coverage ratio.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "codepoints": {
          "description": "Codepoints in the block that the face maps.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "end": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "block",
        "start",
        "end",
        "codepoints",
        "block_size"
      ],
      "type": "object"
    },
    "BundleReport": {
      "description": "What writing a bundle did.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dir": {
          "type": "string"
        },
        "faces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "description": "Font files copied. Fewer than `faces` when one file holds several of them.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "dir",
        "faces",
        "files",
        "bytes"
      ],
      "type": "object"
    },
    "CheckReport": {
      "properties": {
        "errors": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "family": {
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "index": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "subfamily": {
          "type": "string"
        },
        "warnings": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "index",
        "family",
        "subfamily",
        "findings",
        "errors",
        "warnings"
      ],
      "type": "object"
    },
    "CollectionExport": {
      "description": "A collection as written by `collection export`; `schemas/collection.json`.",
      "properties": {
        "exported_at": {
          "description": "RFC 3339.",
          "type": "string"
        },
        "faces": {
          "items": {
            "$ref": "#/$defs/CollectionFace"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "relative_paths": {
          "description": "True when every `CollectionFace::path` is relative to the directory holding this\nfile, which is how a bundle is written. Absent means absolute, as every export\nbefore bundles was.\n\nThe flag is additive and `SCHEMA_VERSION` does not move for it. An older fontina\nreading a bundle ignores it and treats the relative paths as absolute, which\ncosts nothing in practice: the path is the *last* thing `match_collection_face`\ntries, after the identity hash and the PostScript name, and those do not depend\non where the file lives.",
          "type": "boolean"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "name",
        "exported_at",
        "faces"
      ],
      "type": "object"
    },
    "CollectionFace": {
      "description": "One face in an exported collection. On import, faces are matched by identity hash,\nthen PostScript name, then path and index, so a collection survives re-encoding the\nfont (TTF to WOFF2) or moving it.",
      "properties": {
        "blake3": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "identity_hash": {
          "type": "string"
        },
        "index": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "postscript_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "subfamily": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "family",
        "subfamily",
        "identity_hash",
        "blake3",
        "path"
      ],
      "type": "object"
    },
    "CollectionInfo": {
      "properties": {
        "created_at": {
          "description": "Seconds since the Unix epoch.",
          "format": "int64",
          "type": "integer"
        },
        "faces": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "faces",
        "created_at"
      ],
      "type": "object"
    },
    "Conflict": {
      "description": "A face that would clash with the one being activated.",
      "properties": {
        "face": {
          "$ref": "#/$defs/FaceSummary"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "face",
        "reason"
      ],
      "type": "object"
    },
    "DuplicateGroup": {
      "properties": {
        "faces": {
          "items": {
            "$ref": "#/$defs/FaceSummary"
          },
          "type": "array"
        },
        "key": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "key",
        "faces"
      ],
      "type": "object"
    },
    "FaceSummary": {
      "description": "Compact per-face row used by listings.",
      "properties": {
        "activation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActivationState"
            },
            {
              "type": "null"
            }
          ],
          "description": "Activation state recorded by fontina, if any."
        },
        "color": {
          "type": "boolean"
        },
        "container": {
          "type": "string"
        },
        "designer": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": "string"
        },
        "freedom": {
          "$ref": "#/$defs/Freedom",
          "default": "unstated",
          "description": "Whether `license` grants the four freedoms. Derived on read, never stored."
        },
        "glyph_count": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "index": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "italic": {
          "type": "boolean"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "postscript_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "scripts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subfamily": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "variable": {
          "type": "boolean"
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "weight": {
          "format": "float",
          "type": "number"
        },
        "width": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "id",
        "path",
        "index",
        "family",
        "subfamily",
        "weight",
        "width",
        "italic",
        "variable",
        "color",
        "glyph_count",
        "scripts",
        "container"
      ],
      "type": "object"
    },
    "FacetCount": {
      "properties": {
        "count": {
          "format": "int64",
          "type": "integer"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "count"
      ],
      "type": "object"
    },
    "Facets": {
      "description": "Counts of faces per facet value, for the faces matching a filter.",
      "properties": {
        "activation": {
          "description": "`session`, `user`, `installed`, or `none`.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "collection": {
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "color": {
          "format": "int64",
          "type": "integer"
        },
        "container": {
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "faces": {
          "format": "int64",
          "type": "integer"
        },
        "families": {
          "format": "int64",
          "type": "integer"
        },
        "freedom": {
          "description": "`free`, `nonfree`, `unknown` or `unstated`, derived from the license.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "license": {
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "script": {
          "description": "ISO 15924 script codes.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "source": {
          "description": "Registered source directories the faces live under.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "style": {
          "description": "`upright` or `italic`.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "tag": {
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "variable": {
          "format": "int64",
          "type": "integer"
        },
        "vendor": {
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "weight": {
          "description": "CSS weight buckets, `100`..`900`.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "width": {
          "description": "Width buckets as percentages, `50`..`200`.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        }
      },
      "required": [
        "faces",
        "families",
        "weight",
        "width",
        "style",
        "variable",
        "color",
        "container",
        "script",
        "license",
        "freedom",
        "vendor",
        "tag",
        "collection",
        "activation",
        "source"
      ],
      "type": "object"
    },
    "Family": {
      "description": "Faces grouped by typographic family name.",
      "properties": {
        "active": {
          "description": "Faces with an activation record.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "color": {
          "type": "boolean"
        },
        "containers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "designer": {
          "type": [
            "string",
            "null"
          ]
        },
        "faces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "ids": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "italic": {
          "type": "boolean"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "representative": {
          "description": "The face to show for the family: upright, closest to weight 400 and width 100.",
          "format": "int64",
          "type": "integer"
        },
        "scripts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "variable": {
          "type": "boolean"
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "weights": {
          "description": "Lowest and highest weight in the family.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "widths": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "name",
        "faces",
        "ids",
        "representative",
        "variable",
        "color",
        "italic",
        "weights",
        "widths",
        "scripts",
        "containers",
        "active"
      ],
      "type": "object"
    },
    "Finding": {
      "properties": {
        "id": {
          "description": "Stable identifier, `area/check`.",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "id",
        "severity",
        "message"
      ],
      "type": "object"
    },
    "Freedom": {
      "description": "Whether a license grants the four freedoms.",
      "oneOf": [
        {
          "const": "free",
          "description": "The license grants all four freedoms.",
          "type": "string"
        },
        {
          "const": "nonfree",
          "description": "The license withholds at least one of them.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "A license is stated, but it is not one that is known to be free.",
          "type": "string"
        },
        {
          "const": "unstated",
          "description": "The font carries no license information at all. No permission is stated, so in\nlaw none is granted, however the font was meant to be shared.",
          "type": "string"
        }
      ]
    },
    "ImportReport": {
      "properties": {
        "collection": {
          "type": "string"
        },
        "matched": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "missing": {
          "description": "Faces in the file that are not in this index.",
          "items": {
            "$ref": "#/$defs/CollectionFace"
          },
          "type": "array"
        },
        "tags_applied": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "collection",
        "matched",
        "missing",
        "tags_applied"
      ],
      "type": "object"
    },
    "ScanFailure": {
      "properties": {
        "error": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "error"
      ],
      "type": "object"
    },
    "ScanReport": {
      "properties": {
        "candidates": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "faces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "failed": {
          "items": {
            "$ref": "#/$defs/ScanFailure"
          },
          "type": "array"
        },
        "parsed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "removed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "unchanged": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "candidates",
        "parsed",
        "faces",
        "unchanged",
        "removed",
        "failed"
      ],
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "warn",
        "error"
      ],
      "type": "string"
    },
    "Source": {
      "properties": {
        "added_at": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "path": {
          "type": "string"
        },
        "watch": {
          "description": "Followed by `fontina watch`.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "path",
        "watch",
        "kind",
        "added_at"
      ],
      "type": "object"
    },
    "SourceKind": {
      "description": "Why a directory is in the index.",
      "oneOf": [
        {
          "const": "user",
          "description": "Added by the user (`scan <dir>`, `source add`).",
          "type": "string"
        },
        {
          "const": "system",
          "description": "An operating-system font directory (`scan --system`).",
          "type": "string"
        }
      ]
    },
    "Stats": {
      "properties": {
        "activations": {
          "format": "int64",
          "type": "integer"
        },
        "collections": {
          "format": "int64",
          "type": "integer"
        },
        "color_faces": {
          "format": "int64",
          "type": "integer"
        },
        "db_path": {
          "type": "string"
        },
        "faces": {
          "format": "int64",
          "type": "integer"
        },
        "failed_files": {
          "format": "int64",
          "type": "integer"
        },
        "families": {
          "format": "int64",
          "type": "integer"
        },
        "files": {
          "format": "int64",
          "type": "integer"
        },
        "sources": {
          "format": "int64",
          "type": "integer"
        },
        "tags": {
          "format": "int64",
          "type": "integer"
        },
        "variable_faces": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "files",
        "faces",
        "families",
        "variable_faces",
        "color_faces",
        "failed_files",
        "tags",
        "collections",
        "sources",
        "activations",
        "db_path"
      ],
      "type": "object"
    },
    "TagInfo": {
      "properties": {
        "faces": {
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "faces"
      ],
      "type": "object"
    },
    "WatchEvent": {
      "description": "One batch of changes applied to the index.",
      "properties": {
        "paths": {
          "description": "Files re-parsed or dropped, plus directories rescanned.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "report": {
          "$ref": "#/$defs/ScanReport"
        }
      },
      "required": [
        "paths",
        "report"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Every type `fontina --json` prints, one definition each.",
  "title": "fontina CLI output"
}
